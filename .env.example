# AI Registry configuration.
#
# One prefix, REGISTRY_, read by pydantic-settings from the environment or this file.
# Copy to .env and edit. Never commit .env: it is git-ignored for a reason.
#
# The three values under "secrets" have working defaults so the service starts on a laptop,
# and every one of them is wrong in production. They are the reason this file exists:
# a placeholder secret written into docker-compose.yml is a secret that ships.

# --- secrets: change all three outside development -----------------------------------------
# Signs session tokens. Anyone holding it can mint a valid token for any user.
REGISTRY_JWT_SECRET=change-me-in-prod
# Encrypts stored channel configurations. Changing it makes existing ones unreadable, so
# rotate it deliberately rather than casually. Must be 32 bytes.
REGISTRY_SECRET_KEY=change-me-32-bytes-secret-key!!
# The first administrator, created once at startup if no users exist.
REGISTRY_BOOTSTRAP_ADMIN_EMAIL=admin@registry.dev
REGISTRY_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- storage -------------------------------------------------------------------------------
# SQLite is the zero-setup default; compose points this at PostgreSQL instead.
REGISTRY_DATABASE_URL=sqlite+aiosqlite:///./registry.db
REGISTRY_DB_POOL_SIZE=10
REGISTRY_DB_MAX_OVERFLOW=20
# Optional. Empty means no Redis: an in-process cache and an in-process event bus, which is
# fine for one replica and wrong for several — the second replica serves a stale manifest.
REGISTRY_REDIS_URL=
REGISTRY_MANIFEST_CACHE_TTL=300

# --- session ------------------------------------------------------------------------------
REGISTRY_JWT_TTL_SECONDS=28800

# --- similarity: how duplicate tools and agents are found -----------------------------------
# fastembed | hashing | openai. "hashing" needs no model download and finds far less.
REGISTRY_EMBEDDING_PROVIDER=fastembed
REGISTRY_EMBEDDING_MODEL=
REGISTRY_EMBEDDING_API_KEY=
# fastembed | none. The cross-encoder pass that reorders the top pairs.
REGISTRY_RERANKER=fastembed
REGISTRY_RERANKER_MODEL=BAAI/bge-reranker-base
# Cutoff for calling two entities duplicates.
REGISTRY_SIMILARITY_THRESHOLD=0.50
# Cross-encode at most this many candidate pairs per scan, highest cosine first. Anything
# beyond is dropped rather than served with a retrieval-only score.
REGISTRY_RERANK_CAP=500
# CPU-bound, so this is deliberately not "number of cores".
REGISTRY_SCORE_CONCURRENCY=1

# --- in-process caches: entries, not bytes --------------------------------------------------
REGISTRY_PAIR_CACHE_CAP=16384
REGISTRY_PREVIEW_CACHE_CAP=256
REGISTRY_RESOLVE_CACHE_CAP=64
REGISTRY_REPORT_CACHE_CAP=16

# --- pagination -----------------------------------------------------------------------------
# List endpoints default to page_default rows and refuse more than page_max; totals travel
# in the X-Total-Count header.
REGISTRY_PAGE_DEFAULT=100
REGISTRY_PAGE_MAX=500

# --- optional installation-wide AI gateway (Bifrost) -----------------------------------------
# Per-product configuration overrides these.
# REGISTRY_BIFROST_URL=http://bifrost:8080/v1
# REGISTRY_BIFROST_KEY=vk-...
